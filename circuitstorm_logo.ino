#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ============================================================
// CIRCUITSTORM OLED INTRO ANIMATION
// ESP32 DOIT DEVKIT V1 + 128x64 I2C SSD1306 OLED
// SDA = GPIO 21
// SCL = GPIO 22
// OLED address = 0x3C
//
// Animation:
// 1. CircuitStorm graphic sweeps in from LEFT
// 2. Moving particle field follows the sweep
// 3. "CIRCUITSTORM" types in with UNEQUAL timing
// 4. Animation pauses, then loops
// ============================================================

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define OLED_ADDR 0x3C

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

